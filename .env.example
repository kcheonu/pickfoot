# Local Compose only. Replace every placeholder; do not commit a real .env.
POSTGRES_PASSWORD=replace-with-a-long-random-local-password
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=generate-with-python--m-pickfoot-api-auth
SESSION_SECRET=replace-with-at-least-32-random-bytes
WEB_ORIGIN=http://localhost:3000
CORS_ORIGINS=[]
COOKIE_SECURE=false
ENVIRONMENT=development

# For the approved HTTPS Tunnel/Vercel setup:
# WEB_ORIGIN=https://<your-pickfoot-vercel-domain>
# COOKIE_SECURE=true
# ENVIRONMENT=production
# DATABASE_URL, MODEL_STORAGE_DIR, and DATA_STORAGE_DIR must use persistent storage.
